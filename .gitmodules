[submodule ".registry"]
	path = .registry
	url = https://github.com/staffanbetner/staffanbetner.r-universe.dev
	branch = HEAD
[submodule "DHARMa"]
	path = DHARMa
	url = https://github.com/florianhartig/DHARMa
	subdir = DHARMa
[submodule "brms"]
	path = brms
	url = https://github.com/andrjohns/brms
	branch = stanr-stanli
[submodule "collostructions"]
	path = collostructions
	url = https://github.com/skeptikantin/collostructions
[submodule "ggforestplot"]
	path = ggforestplot
	url = https://github.com/NightingaleHealth/ggforestplot
[submodule "glmmTMB"]
	path = glmmTMB
	url = https://github.com/glmmTMB/glmmTMB
	subdir = glmmTMB
[submodule "huttenlocher1991"]
	path = huttenlocher1991
	url = https://github.com/tjmahr/huttenlocher1991
[submodule "logistf"]
	path = logistf
	url = https://github.com/georgheinze/logistf
[submodule "mgcv"]
	path = mgcv
	url = https://github.com/cran/mgcv
[submodule "mmtable2"]
	path = mmtable2
	url = https://github.com/ianmoran11/mmtable2
[submodule "openssl"]
	path = openssl
	url = https://github.com/cran/openssl
[submodule "ordbetareg"]
	path = ordbetareg
	url = https://github.com/saudiwin/ordbetareg_pack
[submodule "rethinking"]
	path = rethinking
	url = https://github.com/staffanbetner/rethinking
[submodule "roomba"]
	path = roomba
	url = https://github.com/cstawitz/roomba
[submodule "stanli"]
	path = stanli
	url = https://github.com/seantalts/stanli
	subdir = r
[submodule "stanpop"]
	path = stanpop
	url = https://github.com/MansMeg/stanpop
[submodule "tjmisc"]
	path = tjmisc
	url = https://github.com/tjmahr/tjmisc
[submodule "x13binary"]
	path = x13binary
	url = https://github.com/StaffanBetner/x13binary
